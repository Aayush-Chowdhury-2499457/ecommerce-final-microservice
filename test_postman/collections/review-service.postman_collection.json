{
  "info": {
    "_postman_id": "ecom-review-service",
    "name": "review-service (via gateway)",
    "description": "Review endpoints routed through the API gateway (http://localhost:8080). Requires a valid JWT - run auth-service > Login first. Create is CUSTOMER-only; update is owner-only; delete is owner-or-admin. rating must be 1-5.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
  },
  "item": [
    {
      "name": "Create Review (CUSTOMER)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": {{productId}},\n  \"orderId\": {{orderId}},\n  \"rating\": 5,\n  \"description\": \"Excellent product, highly recommended.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/reviews", "host": [ "{{base_url}}" ], "path": [ "api", "reviews" ] }
      },
      "response": []
    },
    {
      "name": "Get All Reviews",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/api/reviews", "host": [ "{{base_url}}" ], "path": [ "api", "reviews" ] }
      },
      "response": []
    },
    {
      "name": "Get Review By Id",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/api/reviews/{{reviewId}}", "host": [ "{{base_url}}" ], "path": [ "api", "reviews", "{{reviewId}}" ] }
      },
      "response": []
    },
    {
      "name": "Get Reviews By User",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/api/reviews/users/{{userId}}", "host": [ "{{base_url}}" ], "path": [ "api", "reviews", "users", "{{userId}}" ] }
      },
      "response": []
    },
    {
      "name": "Get Reviews By Product",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/api/reviews/product/{{productId}}", "host": [ "{{base_url}}" ], "path": [ "api", "reviews", "product", "{{productId}}" ] }
      },
      "response": []
    },
    {
      "name": "Get Product Average Rating",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/api/reviews/product/{{productId}}/average", "host": [ "{{base_url}}" ], "path": [ "api", "reviews", "product", "{{productId}}", "average" ] }
      },
      "response": []
    },
    {
      "name": "Update Review (owner)",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"rating\": 4,\n  \"description\": \"Good, but battery could be better.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/reviews/{{reviewId}}", "host": [ "{{base_url}}" ], "path": [ "api", "reviews", "{{reviewId}}" ] }
      },
      "response": []
    },
    {
      "name": "Delete Review (owner-or-admin)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{base_url}}/api/reviews/{{reviewId}}", "host": [ "{{base_url}}" ], "path": [ "api", "reviews", "{{reviewId}}" ] }
      },
      "response": []
    }
  ]
}
