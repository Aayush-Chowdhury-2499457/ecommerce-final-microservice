{
  "info": {
    "_postman_id": "ecom-auth-service",
    "name": "auth-service (via gateway)",
    "description": "Auth endpoints routed through the API gateway (http://localhost:8080). The /api/auth/** routes are PUBLIC at the gateway, so no token is required. Run 'Login' first - it auto-saves the JWT into the {{token}} environment variable used by every other collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": { "type": "noauth" },
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"username\": \"johndoe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"secret123\",\n  \"phoneNumber\": \"9876543210\",\n  \"dateOfBirth\": \"1995-05-20\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/register",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "auth", "register" ]
        },
        "description": "username 5-50 chars, password >= 6 chars, valid email, phoneNumber exactly 10 digits, dateOfBirth in the past."
      },
      "response": []
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    var json = pm.response.json();",
              "    if (json && json.token) {",
              "        pm.environment.set('token', json.token);",
              "        console.log('Saved JWT to {{token}}');",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": [{ "usernameOrEmail": "ADMIN", "password": "admin123456"}] ,
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "http://localhost:8080/api/auth/login",
          "host": [ "http://localhost:8080" ],
          "path": [ "api", "auth", "login" ]
        },
        "description": "Returns { token }. A test script saves it into the {{token}} environment variable automatically."
      },
      "response": []
    },
    {
      "name": "Validate",
      "request": {
        "method": "POST",
        "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
        "url": {
          "raw": "{{base_url}}/api/auth/validate",
          "host": [ "{{base_url}}" ],
          "path": [ "api", "auth", "validate" ]
        },
        "description": "Validates the JWT and returns the claims (userId, role). No body."
      },
      "response": []
    }
  ]
}
