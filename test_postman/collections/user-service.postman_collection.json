{
  "info": {
    "_postman_id": "ecom-user-service",
    "name": "user-service (via gateway)",
    "description": "User and Address endpoints routed through the API gateway (http://localhost:8080). Requires a valid JWT - run auth-service > Login first. The gateway validates the token and injects X-User-Id / X-User-Role, so you never set those headers manually.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
  },
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User (ADMIN)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"username\": \"janedoe\",\n  \"email\": \"jane@example.com\",\n  \"phoneNumber\": \"9876543211\",\n  \"dateOfBirth\": \"1996-03-15\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/users", "host": [ "{{base_url}}" ], "path": [ "api", "users" ] }
          },
          "response": []
        },
        {
          "name": "Get All Users (ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/users", "host": [ "{{base_url}}" ], "path": [ "api", "users" ] }
          },
          "response": []
        },
        {
          "name": "Get User By Id (self-or-admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/users/{{userId}}", "host": [ "{{base_url}}" ], "path": [ "api", "users", "{{userId}}" ] }
          },
          "response": []
        },
        {
          "name": "Get User By Username",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/users/username/{{username}}", "host": [ "{{base_url}}" ], "path": [ "api", "users", "username", "{{username}}" ] }
          },
          "response": []
        },
        {
          "name": "Get User By Email",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/users/email/{{email}}", "host": [ "{{base_url}}" ], "path": [ "api", "users", "email", "{{email}}" ] }
          },
          "response": []
        },
        {
          "name": "Update User (self-or-admin)",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Updated\",\n  \"email\": \"john.updated@example.com\",\n  \"phoneNumber\": \"9876500000\",\n  \"dateOfBirth\": \"1995-05-20\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/users/{{userId}}", "host": [ "{{base_url}}" ], "path": [ "api", "users", "{{userId}}" ] }
          },
          "response": []
        },
        {
          "name": "Delete User (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/api/users/{{userId}}", "host": [ "{{base_url}}" ], "path": [ "api", "users", "{{userId}}" ] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Addresses",
      "item": [
        {
          "name": "Add Address (self-or-admin)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"houseNo\": \"12A\",\n  \"area\": \"MG Road\",\n  \"city\": \"Bangalore\",\n  \"state\": \"Karnataka\",\n  \"country\": \"India\",\n  \"pincode\": \"560001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/users/{{userId}}/addresses", "host": [ "{{base_url}}" ], "path": [ "api", "users", "{{userId}}", "addresses" ] }
          },
          "response": []
        },
        {
          "name": "Get All Addresses (self-or-admin)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/users/{{userId}}/addresses", "host": [ "{{base_url}}" ], "path": [ "api", "users", "{{userId}}", "addresses" ] }
          },
          "response": []
        },
        {
          "name": "Get Address By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/users/{{userId}}/addresses/{{addressId}}", "host": [ "{{base_url}}" ], "path": [ "api", "users", "{{userId}}", "addresses", "{{addressId}}" ] }
          },
          "response": []
        },
        {
          "name": "Update Address (self-or-admin)",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"houseNo\": \"99B\",\n  \"area\": \"Indiranagar\",\n  \"city\": \"Bangalore\",\n  \"state\": \"Karnataka\",\n  \"country\": \"India\",\n  \"pincode\": \"560038\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/users/{{userId}}/addresses/{{addressId}}", "host": [ "{{base_url}}" ], "path": [ "api", "users", "{{userId}}", "addresses", "{{addressId}}" ] }
          },
          "response": []
        },
        {
          "name": "Delete Address (self-or-admin)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/api/users/{{userId}}/addresses/{{addressId}}", "host": [ "{{base_url}}" ], "path": [ "api", "users", "{{userId}}", "addresses", "{{addressId}}" ] }
          },
          "response": []
        }
      ]
    }
  ]
}
