{
  "info": {
    "_postman_id": "ecom-cart-service",
    "name": "cart-service (via gateway)",
    "description": "Shopping cart endpoints routed through the API gateway (http://localhost:8080). All endpoints require a CUSTOMER token. Run auth-service > Login first. The gateway injects X-User-Id so the cart is resolved from the token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
  },
  "item": [
    {
      "name": "Get Cart",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/api/carts", "host": [ "{{base_url}}" ], "path": [ "api", "carts" ] }
      },
      "response": []
    },
    {
      "name": "Add Item",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 2\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/carts/items", "host": [ "{{base_url}}" ], "path": [ "api", "carts", "items" ] }
      },
      "response": []
    },
    {
      "name": "Update Item Quantity",
      "request": {
        "method": "PATCH",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": {{productId}},\n  \"quantity\": 3\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/carts/items", "host": [ "{{base_url}}" ], "path": [ "api", "carts", "items" ] }
      },
      "response": []
    },
    {
      "name": "Remove Item",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{base_url}}/api/carts/items/{{cartItemId}}", "host": [ "{{base_url}}" ], "path": [ "api", "carts", "items", "{{cartItemId}}" ] }
      },
      "response": []
    },
    {
      "name": "Clear Cart",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{base_url}}/api/carts/clear", "host": [ "{{base_url}}" ], "path": [ "api", "carts", "clear" ] }
      },
      "response": []
    },
    {
      "name": "Checkout",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"addressId\": {{addressId}}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/carts/checkout", "host": [ "{{base_url}}" ], "path": [ "api", "carts", "checkout" ] }
      },
      "response": []
    }
  ]
}
