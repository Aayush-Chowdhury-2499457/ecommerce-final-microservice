{
  "info": {
    "_postman_id": "ecom-product-service",
    "name": "product-service (via gateway)",
    "description": "Product and Category endpoints routed through the API gateway (http://localhost:8080). GET endpoints are open to any authenticated user; create/update/delete require ADMIN. Run auth-service > Login first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
  },
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "Create Product (ADMIN)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productName\": \"Laptop\",\n  \"description\": \"14-inch ultrabook\",\n  \"price\": 74999.0,\n  \"stock\": 50,\n  \"categoryId\": {{categoryId}},\n  \"imageUrl\": \"https://example.com/laptop.png\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/products", "host": [ "{{base_url}}" ], "path": [ "api", "products" ] }
          },
          "response": []
        },
        {
          "name": "Get All Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/products", "host": [ "{{base_url}}" ], "path": [ "api", "products" ] }
          },
          "response": []
        },
        {
          "name": "Get Product By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/products/{{productId}}", "host": [ "{{base_url}}" ], "path": [ "api", "products", "{{productId}}" ] }
          },
          "response": []
        },
        {
          "name": "Get Products By Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/products/productName/Laptop", "host": [ "{{base_url}}" ], "path": [ "api", "products", "productName", "Laptop" ] }
          },
          "response": []
        },
        {
          "name": "Get Products By Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/products/category/{{categoryId}}", "host": [ "{{base_url}}" ], "path": [ "api", "products", "category", "{{categoryId}}" ] }
          },
          "response": []
        },
        {
          "name": "Update Product (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productName\": \"Laptop Pro\",\n  \"description\": \"16-inch ultrabook\",\n  \"price\": 99999.0,\n  \"stock\": 40,\n  \"categoryId\": {{categoryId}},\n  \"imageUrl\": \"https://example.com/laptop-pro.png\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/products/{{productId}}", "host": [ "{{base_url}}" ], "path": [ "api", "products", "{{productId}}" ] }
          },
          "response": []
        },
        {
          "name": "Update Stock (ADMIN)",
          "request": {
            "method": "PATCH",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stock\": 100\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/products/{{productId}}/stock", "host": [ "{{base_url}}" ], "path": [ "api", "products", "{{productId}}", "stock" ] }
          },
          "response": []
        },
        {
          "name": "Reduce Stock",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 5\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/products/{{productId}}/reduce-stock", "host": [ "{{base_url}}" ], "path": [ "api", "products", "{{productId}}", "reduce-stock" ] }
          },
          "response": []
        },
        {
          "name": "Restock",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 20\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/products/{{productId}}/restock", "host": [ "{{base_url}}" ], "path": [ "api", "products", "{{productId}}", "restock" ] }
          },
          "response": []
        },
        {
          "name": "Delete Product (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/api/products/{{productId}}", "host": [ "{{base_url}}" ], "path": [ "api", "products", "{{productId}}" ] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create Category (ADMIN)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ,
                        { "key": "Accept", "value": "application/json" } ,
                        { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }],

            "body": {
              "mode": "raw",
              "raw": [{ "categoryName": "Electronics" }],
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/categories", "host": [ "{{base_url}}" ], "path": [ "api", "categories" ] }
          },
          "response": []
        },
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/categories", "host": [ "{{base_url}}" ], "path": [ "api", "categories" ] }
          },
          "response": []
        },
        {
          "name": "Get Category By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/categories/{{categoryId}}", "host": [ "{{base_url}}" ], "path": [ "api", "categories", "{{categoryId}}" ] }
          },
          "response": []
        },
        {
          "name": "Get Category By Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/categories/categoryName/Electronics", "host": [ "{{base_url}}" ], "path": [ "api", "categories", "categoryName", "Electronics" ] }
          },
          "response": []
        },
        {
          "name": "Update Category (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryName\": \"Consumer Electronics\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/categories/{{categoryId}}", "host": [ "{{base_url}}" ], "path": [ "api", "categories", "{{categoryId}}" ] }
          },
          "response": []
        },
        {
          "name": "Delete Category (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{base_url}}/api/categories/{{categoryId}}", "host": [ "{{base_url}}" ], "path": [ "api", "categories", "{{categoryId}}" ] }
          },
          "response": []
        }
      ]
    }
  ]
}
