{
  "info": {
    "_postman_id": "ecom-order-service",
    "name": "order-service (via gateway)",
    "description": "Order endpoints routed through the API gateway (http://localhost:8080). Requires a valid JWT - run auth-service > Login first. Get-all and status-update require ADMIN; user/order lookups are self-or-admin. orderStatus: PLACED|CONFIRMED|SHIPPED|DELIVERED|CANCELLED. paymentStatus: PENDING|PAID|FAILED|REFUNDED.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
  },
  "item": [
    {
      "name": "Place Order",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": {{userId}},\n  \"shoppingCartId\": {{shoppingCartId}},\n  \"addressId\": {{addressId}}\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/orders", "host": [ "{{base_url}}" ], "path": [ "api", "orders" ] }
      },
      "response": []
    },
    {
      "name": "Get All Orders (ADMIN)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/api/orders", "host": [ "{{base_url}}" ], "path": [ "api", "orders" ] }
      },
      "response": []
    },
    {
      "name": "Get Orders By User (self-or-admin)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/api/orders/users/{{userId}}", "host": [ "{{base_url}}" ], "path": [ "api", "orders", "users", "{{userId}}" ] }
      },
      "response": []
    },
    {
      "name": "Get Order By Id (self-or-admin)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/api/orders/{{orderId}}", "host": [ "{{base_url}}" ], "path": [ "api", "orders", "{{orderId}}" ] }
      },
      "response": []
    },
    {
      "name": "Has Purchased",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/api/orders/users/{{userId}}/products/{{productId}}/has-purchased", "host": [ "{{base_url}}" ], "path": [ "api", "orders", "users", "{{userId}}", "products", "{{productId}}", "has-purchased" ] }
      },
      "response": []
    },
    {
      "name": "Update Order Status (ADMIN)",
      "request": {
        "method": "PATCH",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderStatus\": \"CONFIRMED\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/orders/{{orderId}}/status", "host": [ "{{base_url}}" ], "path": [ "api", "orders", "{{orderId}}", "status" ] }
      },
      "response": []
    },
    {
      "name": "Update Payment Status",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paymentStatus\": \"PAID\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{base_url}}/api/orders/{{orderId}}/payment-status", "host": [ "{{base_url}}" ], "path": [ "api", "orders", "{{orderId}}", "payment-status" ] }
      },
      "response": []
    },
    {
      "name": "Cancel Order (self-or-admin)",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": { "raw": "{{base_url}}/api/orders/{{orderId}}/cancel", "host": [ "{{base_url}}" ], "path": [ "api", "orders", "{{orderId}}", "cancel" ] }
      },
      "response": []
    }
  ]
}
